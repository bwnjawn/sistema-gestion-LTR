# Copia este archivo como `.env` y completa los valores. El archivo `.env` NO se sube a git.
#
# Dónde encontrarlos: panel de Supabase > Project Settings > API (o "API Keys").
# Solo van aquí la URL del proyecto y la clave pública (anon o "publishable").
# NUNCA pongas aquí la clave secreta (service_role o "secret"): todo lo que empieza con VITE_ queda
# visible en el navegador de cualquier visitante.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica
