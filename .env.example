# Copia este archivo como `.env` y completa los valores. El archivo `.env` NO se sube a git.
#
# Dónde encontrarlos: panel de Supabase > Project Settings > API (o "API Keys").
# Solo van aquí la URL del proyecto y la clave pública ("publishable", antes llamada "anon").
# NUNCA pongas aquí la clave secreta (service_role o "secret"): todo lo que empieza con VITE_ queda
# visible en el navegador de cualquier visitante.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Avisos push de solicitudes nuevas (SCRUM-68). Clave PÚBLICA de VAPID: se genera una vez con
# `npx web-push generate-vapid-keys`. La PRIVADA nunca va aquí: solo como secreto de la Edge Function `avisar-solicitud`.
VITE_VAPID_PUBLIC_KEY=
